  "kinds": [
    {
      "id": "fortification",
      "name": "Fortification",
      "note": "Walls, castles, forts. Built against somebody, which is why they carry the clearest politics of any structure."
    },
    {
      "id": "worship",
      "name": "Place of worship",
      "note": "Temples, churches, mosques, stupas, shrines."
    },
    {
      "id": "tomb",
      "name": "Tomb or burial",
      "note": "Pyramids, mausolea, barrows, necropolises."
    },
    {
      "id": "palace",
      "name": "Palace or seat",
      "note": "Where power sat, as distinct from where it defended itself."
    },
    {
      "id": "monument",
      "name": "Monument or statue",
      "note": "Built to be looked at rather than used."
    },
    {
      "id": "engineering",
      "name": "Engineering work",
      "note": "Bridges, aqueducts, canals, roads, dams — the structures whose purpose is entirely function."
    },
    {
      "id": "settlement",
      "name": "Settlement or site",
      "note": "Cities, archaeological sites, whole places rather than single buildings."
    },
    {
      "id": "industry",
      "name": "Industrial site",
      "note": "Mines, mills, furnaces, yards. The heritage that is usually listed last and demolished first."
    },
    {
      "id": "natural",
      "name": "Natural wonder",
      "note": "Not built. Derives from rock, water and time — and sometimes from living things, which is what makes Plitvice a different claim from a canyon."
    },
    {
      "id": "rock_art",
      "name": "Rock art or early mark",
      "note": "The oldest deliberate marks people left on places, and the only kind of site that is global at every date."
    }
  ],
